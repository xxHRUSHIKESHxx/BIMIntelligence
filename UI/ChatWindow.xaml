<Window x:Class="BIMIntelligence.UI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIM Intelligence"
        Width="520"
        Height="700"
        MinWidth="420"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">

	<Grid Background="#F5F6F7">

		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<!-- Header -->

		<Border Grid.Row="0"
                Background="#1F2937"
                Padding="16">

			<StackPanel>

				<TextBlock Text="BIM Intelligence"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"/>

				<TextBlock Text="Revit AI Assistant"
                           Foreground="#D1D5DB"
                           FontSize="12"
                           Margin="0,3,0,0"/>

			</StackPanel>

		</Border>


		<!-- Chat history -->

		<ScrollViewer Grid.Row="1"
                      x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14">

			<StackPanel x:Name="ChatPanel"/>

		</ScrollViewer>


		<!-- Input -->

		<Border Grid.Row="2"
                Background="White"
                BorderBrush="#D1D5DB"
                BorderThickness="1,1,0,0"
                Padding="10">

			<Grid>

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>


				<TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         MinHeight="38"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         BorderBrush="#D1D5DB"
                         ToolTip="Ask a question about the Revit model"
                         KeyDown="MessageInput_KeyDown"/>


				<Button x:Name="SendButton"
                        Grid.Column="1"
                        Content="Send"
                        Width="75"
                        Height="38"
                        Margin="8,0,0,0"
                        Click="SendButton_Click"/>

			</Grid>

		</Border>

	</Grid>

</Window>